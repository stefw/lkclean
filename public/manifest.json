{
  "manifest_version": 3,
  "name": "lkclean",
  "version": "0.1.0",
  "description": "Masque les posts LinkedIn inintéressants grâce à Jev (TypeSafe AI).",
  "permissions": ["storage"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "lkclean — options" }
}
