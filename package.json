    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefw/lkclean.git"
  },
  "homepage": "https://github.com/stefw/lkclean#readme",
  "keywords": [
    "chrome-extension",
    "linkedin",
    "feed-filter",
    "typesafe-ai",
